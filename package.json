{
  "name": "jareed-soft",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/api", "apps/mobile", "frontend"],
  "scripts": {
    "test": "npm --workspace apps/api test",
    "test:web": "npm --workspace jareed-soft-frontend test",
    "build:web": "npm --workspace jareed-soft-frontend run build",
    "start": "npm --workspace apps/api start",
    "android:sync": "npm --workspace @jareed/mobile run sync",
    "android:build": "npm --workspace @jareed/mobile run build:debug"
  },
  "engines": { "node": ">=22" }
}
