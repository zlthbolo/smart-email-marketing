# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
# Production (recommended): use the pooled Neon PostgreSQL connection string.
DATABASE_URL=

# Local/dev fallback when DATABASE_URL is empty
DB_HOST=localhost
DB_PORT=5432
DB_USER=smart_email
DB_PASSWORD=change_me
DB_NAME=smart_email_marketing

# Redis / Bull queue
# Production: use the TLS/private Redis URL supplied by the hosting provider.
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=24h

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# AI (Gemini)
GEMINI_API_KEY=

# Proxy Services
PROXYSCRAPE_API_KEY=
WEBSHARE_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Tracking
TRACKING_PIXEL_ENABLED=true
TRACKING_LINK_PREFIX=http://localhost:3001/track

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
